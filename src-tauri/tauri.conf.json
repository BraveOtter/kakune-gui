{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kakune",
  "version": "0.1.0",
  "identifier": "io.github.braveotter.kakune",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kakune",
        "width": 960,
        "height": 680,
        "minWidth": 600,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Kakune contributors",
    "category": "DeveloperTool",
    "shortDescription": "Desktop client for Kakune Core",
    "longDescription": "A local-first desktop client for Kakune workflow automation.",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  }
}
